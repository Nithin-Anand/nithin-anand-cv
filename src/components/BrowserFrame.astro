---
interface Props {
  url: string;
  aspectRatio?: string;
}
const { url, aspectRatio = '16/9' } = Astro.props;
---

<div class="rounded-md overflow-hidden border border-term-border shadow-md">
  <!-- Chrome bar -->
  <div class="flex items-center gap-2 px-3 py-2 bg-[#2D2D2D]">
    <div class="flex gap-1.5 flex-shrink-0">
      <div class="w-3 h-3 rounded-full bg-[#FF5F57]"></div>
      <div class="w-3 h-3 rounded-full bg-[#FFBD2E]"></div>
      <div class="w-3 h-3 rounded-full bg-[#28CA41]"></div>
    </div>
    <div class="flex-1 flex items-center gap-1.5 bg-[#3D3D3D] rounded px-2 py-1 min-w-0">
      <svg class="w-3 h-3 text-[#9E9E9E] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
      <span class="text-[#C0C0C0] text-xs truncate font-mono">{url}</span>
    </div>
  </div>
  <!-- iframe embed -->
  <div class="overflow-hidden" style={`aspect-ratio: ${aspectRatio}`}>
    <iframe
      src={url}
      title={url}
      loading="lazy"
      class="w-full h-full border-0"
      sandbox="allow-scripts allow-same-origin"
    ></iframe>
  </div>
</div>
