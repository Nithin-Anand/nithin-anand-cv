---
import { getCollection } from 'astro:content';

const contacts = await getCollection('contact');
---

<div class="flex flex-col gap-3">
  {contacts.map((item) => (
    <a
      href={item.data.url}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-4 text-sm hover:text-term-bright transition-colors group w-full max-w-full"
    >
      <span class="text-term-cyan group-hover:text-term-bright transition-colors select-none">→</span>
      <span class="text-term-muted w-16 flex-shrink-0">{item.data.title.toLowerCase()}</span>
      <span class="text-term-text group-hover:text-term-cyan transition-colors break-all">
        {item.data.url.replace('mailto:', '')}
      </span>
    </a>
  ))}
</div>
