---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const { title, tags, url } = entry.data;
const { Content } = await entry.render();
---

<article class="py-4 border-t border-term-border first:border-t-0">
  <div class="flex items-baseline gap-2 mb-1">
    <span class="text-term-cyan text-sm flex-shrink-0 select-none">›</span>
    <div class="flex items-baseline gap-3 flex-wrap">
      {url ? (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-term-bright font-bold text-lg leading-tight hover:text-term-cyan transition-colors"
        >
          {title}
        </a>
      ) : (
        <h3 class="text-term-bright font-bold text-lg leading-tight">{title}</h3>
      )}

    </div>
  </div>

  <div class="ml-4 prose prose-sm max-w-none mt-2 break-words
    prose-li:text-term-text prose-a:text-term-cyan prose-a:no-underline hover:prose-a:underline">
    <Content />
  </div>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-3 ml-4">
      {tags.map((tag) => (
        <span class="text-xs text-term-muted border border-term-border px-1.5 py-0.5">
          --{tag}
        </span>
      ))}
    </div>
  )}

</article>
