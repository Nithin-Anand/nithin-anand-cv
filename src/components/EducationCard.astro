---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'studies'>;
}
const { entry } = Astro.props;
const { title, subtitle, location, date, tags } = entry.data;
const { Content } = await entry.render();
---

<article class="py-4">
  <div class="flex items-baseline gap-2 mb-1">
    <span class="text-term-cyan text-sm flex-shrink-0 select-none">›</span>
    <h3 class="text-term-bright font-bold text-lg md:text-xl leading-tight">{title}</h3>
  </div>

  {subtitle && (
    <p class="text-term-cyan text-sm ml-4 mt-0.5">{subtitle}</p>
  )}

  <p class="text-term-muted text-xs ml-4 mb-3 mt-1">
    {location}{date ? ` · ${date}` : ''}
  </p>

  <div class="ml-4 prose prose-sm max-w-none
    prose-li:text-term-text prose-em:text-term-text prose-strong:text-term-bright">
    <Content />
  </div>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-4 ml-4">
      {tags.map((tag) => (
        <span class="text-xs text-term-muted border border-term-border px-1.5 py-0.5">
          --{tag}
        </span>
      ))}
    </div>
  )}
</article>
