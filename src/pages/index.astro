---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Masthead from '../components/Masthead.astro';
import SectionDivider from '../components/SectionDivider.astro';
import WorkCard from '../components/WorkCard.astro';
import EducationCard from '../components/EducationCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';

const works = (await getCollection('works')).sort(
  (a, b) => b.data.order - a.data.order
);
const studies = await getCollection('studies');
const projects = await getCollection('projects');

const about = `
  <p>I am a software engineer working in FinTech, primarily in Python and Java with an emphasis on data-driven applications.</p>
  <p>When away from the keyboard, I love to take photos, read, boulder and cook.</p>
`;
---

<Layout>
  <div class="max-w-6xl mx-auto">
    <Masthead />

    <main>
      <!-- About -->
      <section class="px-4 md:px-8 py-8 max-w-2xl">
        <p class="text-term-muted text-xs mb-4 select-none">// about</p>
        <article class="text-term-text text-sm leading-relaxed [&_p]:mb-3 [&_p:last-child]:mb-0" set:html={about} />
      </section>

      <!-- Work -->
      <SectionDivider title="Work" />
      <div class="px-4 md:px-8 pb-8 divide-y divide-term-border">
        {works.map((entry) => <WorkCard entry={entry} />)}
      </div>

      <!-- Studies -->
      <SectionDivider title="Education" />
      <div class="px-4 md:px-8 pb-8">
        {studies.map((entry) => <EducationCard entry={entry} />)}
      </div>

      <!-- Projects -->
      <SectionDivider title="Projects" label="Portfolio" />
      <div class="px-4 md:px-8 pb-8">
        {projects.map((entry) => <ProjectCard entry={entry} />)}
      </div>

      <!-- Contact -->
      <SectionDivider title="Contact" />
      <div class="px-4 md:px-8 pb-8">
        <ContactSection />
      </div>
    </main>

    <Footer />
  </div>
</Layout>
